
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function fam(fid) { return get(/databases/$(database)/documents/families/$(fid)).data; }
    function isMember(fid) { return signedIn() && me() in fam(fid).members; }
    function premium(f) {
      return f.get('paidUntil', timestamp.value(0)) > request.time;
    }
    function canUse(fid) {
      let f = fam(fid);
      return signedIn() && me() in f.members && (f.owner == me() || premium(f));
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'lang', 'trialStart', 'familyId'])
        && request.resource.data.trialStart == request.time;
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lang', 'familyId']);
      allow delete: if false;

      match /pets/{petId} {
        allow read: if signedIn() && me() == uid;
        allow write: if false;
      }

      match /push/{pushId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'ownerName'])
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.owner == me()
        && getAfter(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.code == code;
      allow delete: if signedIn() && fam(resource.data.familyId).owner == me();
      allow update: if false;
    }

    match /families/{fid} {
      allow read: if signedIn() && (fid == me() || me() in resource.data.members);

      allow create: if signedIn() && fid == me()
        && request.resource.data.keys().hasOnly(['owner', 'members', 'memberInfo', 'code', 'name', 'trialStart'])
        && request.resource.data.owner == me()
        && request.resource.data.members == [me()]
        && (request.resource.data.trialStart == request.time
            || request.resource.data.trialStart == userData(me()).trialStart);

      allow update: if signedIn() && (
        (resource.data.owner == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code', 'members', 'memberInfo'])
          && resource.data.members.hasAll(request.resource.data.members)
          && me() in request.resource.data.members)
        ||
        (!(me() in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'joinCode'])
          && request.resource.data.joinCode == resource.data.code
          && premium(resource.data)
          && request.resource.data.members.hasAll(resource.data.members)
          && me() in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 6)
        ||
        (me() in resource.data.members && resource.data.owner != me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo'])
          && !(me() in request.resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members.removeAll([me()]))
          && request.resource.data.members.size() == resource.data.members.size() - 1)
      );
      allow delete: if false;

      match /pets/{petId} {
        allow read, create, update, delete: if canUse(fid);
      }

      match /recetas/{rid} {
        allow read, delete: if canUse(fid);
        allow create, update: if canUse(fid) && request.resource.data.thumb.size() < 120000;
      }
      match /recetasImg/{rid} {
        allow read, delete: if canUse(fid);
        allow create, update: if canUse(fid) && request.resource.data.img.size() < 950000;
      }
    }
  }
}
